# 应用对外监听端口。
# Docker 部署时会同时作为容器内部端口和宿主机映射端口使用。
# 如果端口被占用，可以改成其他不常用端口，例如 19073。
APP_PORT=18473

# 应用最终对外访问地址。
# 本地开发/内网访问可以使用 http://localhost:18473 或 http://服务器IP:18473。
# 正式部署到域名后，请改成你的 HTTPS 域名，例如 https://resume.example.com。
# 系统会用它生成后台里的定制页链接、作品链接等完整访问地址。
APP_URL=http://localhost:18473

# SQLite 数据库文件路径。
# Docker 部署时推荐保持默认值，数据库会存放在容器的 /app/data 目录，
# 并通过 docker-compose 的 sqlite_data volume 持久化。
# 本地非 Docker 运行时可以改成本机路径，例如 ./data/onlyweb.db。
DATABASE_PATH=/app/data/onlyweb.db

# 登录会话签名密钥。
# 用于保护管理员登录 Cookie，生产环境必须改成足够长、随机、不可猜测的字符串。
# 示例生成方式：openssl rand -base64 32
SESSION_SECRET=change-me

# 初始化管理员邮箱。
# 首次启动时，如果系统中还没有管理员账号，会使用该邮箱创建默认管理员。
# 后续如果数据库中已经存在管理员账号，修改该值不会自动修改已有账号。
ADMIN_EMAIL=admin@example.com

# 初始化管理员密码。
# 首次启动时，如果系统中还没有管理员账号，会使用该密码创建默认管理员。
# 生产环境必须修改为强密码；数据库中已有管理员后，修改该值不会自动修改已有密码。
ADMIN_PASSWORD=password


# 宿主机上的 Obsidian vault 路径。
# Docker Compose 会把这个目录挂载进容器；后台上传知识库文档会写入该目录。
# 如果 onlyWeb 与 wiki 目录同级，默认 ../wiki/vault 即可；Linux 服务器可改成服务器上的 vault 目录。
WIKI_HOST_VAULT_PATH=../wiki/vault

# 宿主机上允许后台目录选择器浏览的根目录。
# LinuxOS 如果项目位于 /root/onlyweb，建议设置为 /root/onlyweb，这样可以在页面中选择 /root/onlyweb/wiki/vault。
WIKI_HOST_BROWSE_ROOT=../wiki

# 容器内用于浏览宿主机目录的挂载点。
# 通常保持默认值，不需要修改。
WIKI_CONTAINER_BROWSE_ROOT=/host-browse

# 容器内部读取 Obsidian vault 的路径。
# 通常保持 /app/wiki-vault，不需要修改；也可以登录后台 /admin/wiki 后在页面中维护。
WIKI_VAULT_PATH=/app/wiki-vault

# Wiki 是否公开访问。
# false 表示只有管理员登录后可访问 /wiki；true 表示所有访客都可以访问。也可以在后台 /admin/wiki 中维护。
WIKI_PUBLIC=false

# Wiki 扫描时忽略的目录，多个目录用英文逗号分隔。
# 建议忽略 .obsidian 和 _raw，避免展示 Obsidian 配置或原始归档材料。也可以在后台 /admin/wiki 中维护。
WIKI_EXCLUDE_DIRS=.obsidian,_raw,.git

# 应用运行时可同步更新的 .env 文件路径。
# Docker 部署时 docker-compose 会把项目目录挂载到 /app-config，因此宿主机 .env 对应 /app-config/.env。
ENV_FILE_PATH=/app-config/.env
